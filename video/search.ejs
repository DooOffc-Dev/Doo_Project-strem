<%- include('layout') %>
<div class="mb-8">
  <h1 class="text-2xl font-bold mb-4">Cari Anime / Drama</h1>
  <div class="flex gap-2 mb-6">
    <input id="queryInput" type="text" placeholder="Cari judul..." class="bg-[#1e293b] border border-gray-600 rounded-lg px-4 py-2 w-full max-w-md focus:outline-none focus:border-blue-500 text-white">
    <select id="sourceSelect" class="bg-[#1e293b] border border-gray-600 rounded-lg px-3 py-2 focus:outline-none focus:border-blue-500 text-white">
      <option value="anoboy">Anoboy</option>
      <option value="dracinema">Dracinema</option>
      <option value="drakor">Drakor</option>
      <option value="gomunime">Gomunime</option>
      <option value="nt">NT</option>
      <option value="otakudesu">Otakudesu</option>
      <option value="samehadaku">Samehadaku</option>
    </select>
    <button onclick="doSearch()" class="bg-blue-600 px-4 py-2 rounded-lg hover:bg-blue-500 transition">Cari</button>
  </div>
  <div id="grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    <p class="col-span-full text-center text-gray-400 text-sm py-10">Masukkan kata kunci dan tekan Cari</p>
  </div>
</div>
<script>
async function doSearch() {
  const query = document.getElementById('queryInput').value.trim();
  const source = document.getElementById('sourceSelect').value;
  if (!query) return alert('Masukkan judul!');
  const grid = document.getElementById('grid');
  grid.innerHTML = `<div class="col-span-full text-center py-10 text-blue-400"><i class="fas fa-spinner fa-spin"></i> Mencari di ${source}...</div>`;
  try {
    const res = await fetch(`/api/search/${source}/${encodeURIComponent(query)}`);
    const json = await res.json();
    if (!json.items.length) {
      grid.innerHTML = `<p class="col-span-full text-center text-gray-400 py-10">Tidak ada hasil untuk "${query}" di ${source}</p>`;
      return;
    }
    grid.innerHTML = json.items.map(item => `
      <a href="/detail/${source}/${item.slug}" class="block group">
        <div class="bg-[#1e293b] rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition duration-300">
          <div class="relative aspect-[3/4]">
            <img src="${item.poster || 'https://via.placeholder.com/300x400?text=No+Image'}" class="w-full h-full object-cover" alt="${item.title}" onerror="this.src='https://via.placeholder.com/300x400?text=Error'">
            ${item.episode ? `<span class="absolute bottom-2 right-2 bg-black/70 px-2 py-1 text-xs rounded">${item.episode}</span>` : ''}
          </div>
          <div class="p-2">
            <h3 class="text-sm font-semibold truncate">${item.title}</h3>
            ${item.score ? `<p class="text-xs text-yellow-400">${item.score}</p>` : ''}
          </div>
        </div>
      </a>
    `).join('');
  } catch (e) {
    grid.innerHTML = `<p class="col-span-full text-center text-red-400 py-10">Error: ${e.message}</p>`;
  }
}
</script>