<%- include('layout') %>
<div class="mb-8">
  <h1 class="text-2xl font-bold mb-4 bg-gradient-to-r from-blue-400 to-purple-400 text-transparent bg-clip-text">
    Pilih Sumber
  </h1>
  <div class="flex flex-wrap gap-3 mb-6">
    <button onclick="loadHome('anoboy')" class="bg-blue-600/80 px-5 py-2 rounded-full text-sm font-semibold hover:bg-blue-500 transition">Anoboy</button>
    <button onclick="loadHome('dracinema')" class="bg-purple-600/80 px-5 py-2 rounded-full text-sm font-semibold hover:bg-purple-500 transition">Dracinema</button>
    <button onclick="loadHome('drakor')" class="bg-pink-600/80 px-5 py-2 rounded-full text-sm font-semibold hover:bg-pink-500 transition">Drakor</button>
    <button onclick="loadHome('gomunime')" class="bg-green-600/80 px-5 py-2 rounded-full text-sm font-semibold hover:bg-green-500 transition">Gomunime</button>
    <button onclick="loadHome('nt')" class="bg-cyan-600/80 px-5 py-2 rounded-full text-sm font-semibold hover:bg-cyan-500 transition">NT</button>
    <button onclick="loadHome('otakudesu')" class="bg-orange-600/80 px-5 py-2 rounded-full text-sm font-semibold hover:bg-orange-500 transition">Otakudesu</button>
    <button onclick="loadHome('samehadaku')" class="bg-red-600/80 px-5 py-2 rounded-full text-sm font-semibold hover:bg-red-500 transition">Samehadaku</button>
  </div>
  <div id="grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
    <p class="col-span-full text-center text-gray-400 text-sm py-10">Klik tombol di atas untuk mulai scraping</p>
  </div>
</div>
<script>
async function loadHome(source) {
  const grid = document.getElementById('grid');
  grid.innerHTML = `<div class="col-span-full text-center py-10 text-blue-400"><i class="fas fa-spinner fa-spin"></i> Loading dari ${source}...</div>`;
  try {
    const res = await fetch(`/api/home/${source}`);
    const json = await res.json();
    grid.innerHTML = json.items.map(item => `
      <a href="/detail/${source}/${item.slug}" class="block group">
        <div class="bg-[#1e293b] rounded-xl overflow-hidden shadow-lg hover:shadow-blue-500/20 transition duration-300">
          <div class="relative aspect-[3/4]">
            <img src="${item.poster || 'https://via.placeholder.com/300x400?text=No+Image'}" class="w-full h-full object-cover" alt="${item.title}" onerror="this.src='https://via.placeholder.com/300x400?text=Error'">
            ${item.episode ? `<span class="absolute bottom-2 right-2 bg-black/70 px-2 py-1 text-xs rounded">${item.episode}</span>` : ''}
          </div>
          <div class="p-2">
            <h3 class="text-sm font-semibold truncate">${item.title}</h3>
            ${item.score ? `<p class="text-xs text-yellow-400">${item.score}</p>` : ''}
          </div>
        </div>
      </a>
    `).join('');
  } catch (e) {
    grid.innerHTML = `<p class="col-span-full text-center text-red-400 py-10">Error: ${e.message}</p>`;
  }
}
</script>