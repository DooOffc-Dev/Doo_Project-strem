<%- include('layout') %>
<div class="max-w-4xl mx-auto">
  <button onclick="history.back()" class="mb-4 bg-gray-700 px-4 py-2 rounded hover:bg-gray-600"><i class="fas fa-arrow-left"></i> Kembali</button>
  <div id="detailContainer" class="bg-[#1e293b] rounded-xl p-4 md:p-6 shadow-lg">
    <div class="text-center py-10 text-blue-400"><i class="fas fa-spinner fa-spin"></i> Memuat detail...</div>
  </div>
</div>
<script>
const source = '<%= source %>';
const slug = '<%= slug %>';
async function loadDetail() {
  const container = document.getElementById('detailContainer');
  try {
    const res = await fetch(`/api/detail/${source}/${slug}`);
    const data = await res.json();
    container.innerHTML = `
      <div class="flex flex-col md:flex-row gap-6">
        <div class="w-full md:w-1/3">
          <img src="${data.poster || 'https://via.placeholder.com/300x400?text=No+Image'}" class="w-full rounded-lg shadow" onerror="this.src='https://via.placeholder.com/300x400?text=Error'">
        </div>
        <div class="w-full md:w-2/3">
          <h1 class="text-2xl font-bold mb-2">${data.title}</h1>
          <div class="flex flex-wrap gap-2 mb-4">
            ${(data.genres || []).map(g => `<span class="bg-blue-600/50 px-2 py-1 text-xs rounded">${g.name || g}</span>`).join('')}
          </div>
          <p class="text-gray-300 mb-6 leading-relaxed">${data.synopsis || 'Sinopsis tidak tersedia.'}</p>
          ${data.info ? `<div class="grid grid-cols-2 gap-2 text-sm mb-6">${Object.entries(data.info).map(([k,v]) => `<div><span class="text-gray-400">${k}:</span> <span class="text-white">${v.text || v}</span></div>`).join('')}</div>` : ''}
          <h2 class="text-xl font-bold mb-3">Daftar Episode</h2>
          <div class="flex flex-wrap gap-2 max-h-60 overflow-y-auto">
            ${(data.episodes || []).map(ep => `
              <a href="/watch/${source}/${slug}/${ep.episode || ep.number || ep.title.match(/\d+/)?.[0] || 1}" class="bg-gray-700 px-3 py-1 rounded text-sm hover:bg-gray-600 transition">
                ${ep.title || `Episode ${ep.episode || ep.number || '1'}`}
              </a>
            `).join('') || '<p class="text-gray-400">Belum ada episode.</p>'}
          </div>
        </div>
      </div>
    `;
  } catch (e) {
    container.innerHTML = `<p class="text-red-400 text-center py-10">Error: ${e.message}</p>`;
  }
}
loadDetail();
</script>